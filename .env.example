# Telegram bot tokeni (@BotFather -> /newbot)
BOT_TOKEN=123456:ABC-your-token

# SQLite bazasi yo'li (Docker ichida /app/data/bot.db ga o'rnatiladi)
DB_PATH=data/bot.db

# Vaqt zonasi (IANA formatida)
TZ=Asia/Tashkent

# Ertalabki reja yuboriladigan soat (sozlamalarda yoqilgan guruhlar uchun)
MORNING_SUMMARY_HOUR=9

# Kechki kundalik yuboriladigan soat (sozlamalarda yoqilgan guruhlar uchun)
DAILY_SUMMARY_HOUR=20
